{
  "extends": ["html-validate:standard"],
  "rules": {
    "attr-quotes": "off",
    "deprecated": "off",
    "element-permitted-content": "off",
    "no-deprecated-attr": "off",
    "no-inline-style": "off",
    "no-trailing-whitespace": "off",
    "prefer-tbody": "off",
    "void-style": "off",
    "wcag/h63": "off"
  }
}
