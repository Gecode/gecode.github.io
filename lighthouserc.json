{
  "ci": {
    "collect": {
      "staticDistDir": "_site",
      "url": [
        "/",
        "/news"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.7
          }
        ]
      }
    }
  }
}
