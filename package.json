{
  "name": "gecode-github-io",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:static": "node ./scripts/prepare-static.mjs",
    "build": "npm run prepare:static && astro build",
    "build:deploy": "npm run build && node ./scripts/copy-archives.mjs",
    "check:html": "./scripts/check-html.sh",
    "check:mode": "./scripts/check-executable-bits.sh",
    "check:quality": "npm run build && npm run check:mode && npm run check:html",
    "dev": "npm run prepare:static && astro dev",
    "preview": "astro preview"
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "html-validate": "^10.17.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "minimatch": "^10.2.4"
  }
}
