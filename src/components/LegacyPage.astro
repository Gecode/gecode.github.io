---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadLegacyPage } from "../lib/legacy-content";

interface Props {
  source: string;
}

const { source } = Astro.props;
const page = await loadLegacyPage(source);
const title = String(page.data.title ?? "Gecode");
const headline = page.data.headline ? String(page.data.headline) : "Gecode";
const description = page.data.description ? String(page.data.description) : undefined;
---

<BaseLayout title={title} headline={headline} description={description}>
  <div set:html={page.body} />
</BaseLayout>
