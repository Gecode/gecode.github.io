---
import { navigation } from "../data/site";
import type { NewsItem } from "../lib/legacy-content";

interface Props {
  currentPath: string;
  home?: boolean;
  latestNews?: NewsItem[];
}

const { currentPath, home = false, latestNews = [] } = Astro.props;
const isActive = (href: string) =>
  (href === "/" && currentPath === "/") || currentPath === href;
---

<aside class="site-sidebar">
  <div class="site-sidebar-logo">
    {!home && (
      <a class="sidebar-brand" href="/">
        <img src="/images/gecode-logo-100.png" alt="Gecode logo" width="155" height="100" loading="lazy" decoding="async" />
      </a>
    )}
  </div>

  <nav class="desktop-navigation" aria-label="Primary">
    {navigation.map((group) => (
      <ul class="site-nav-group">
        {group.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={["site-nav-link", { "is-active": isActive(item.href) }]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    ))}
  </nav>

  {home && latestNews.length > 0 && (
    <section class="sidebar-news" aria-labelledby="latest-news-title">
      <div class="sidebar-section-heading">
        <h2 id="latest-news-title">Latest news</h2>
        <a href="/news/">All news</a>
      </div>
      <ol>
        {latestNews.slice(0, 5).map((item) => (
          <li>
            <time datetime={item.date}>{item.date}</time>
            <h3>{item.title}</h3>
            <div set:html={item.body} />
          </li>
        ))}
      </ol>
    </section>
  )}
</aside>
