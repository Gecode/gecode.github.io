---
import MobileNavigation from "./MobileNavigation";
import { navigation } from "../data/site";
import type { NewsItem } from "../lib/legacy-content";

interface Props {
  currentPath: string;
  home?: boolean;
  latestNews?: NewsItem[];
}

const { currentPath, home = false, latestNews = [] } = Astro.props;
const isActive = (href: string) =>
  (href === "/" && currentPath === "/") || currentPath === href;
---

<aside class="site-sidebar">
  <a class="sidebar-brand" href="/" aria-label="Gecode home">
    <img src="/images/gecode-logo-100.png" alt="" width="155" height="100" loading="eager" decoding="async" />
    <span>Gecode</span>
  </a>

  <MobileNavigation groups={navigation} currentPath={currentPath} client:media="(max-width: 859px)" />

  <nav class="desktop-navigation" aria-label="Primary">
    {navigation.map((group) => (
      <ul class="site-nav-group">
        {group.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={["site-nav-link", { "is-active": isActive(item.href) }]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    ))}
  </nav>

  {home && latestNews.length > 0 && (
    <section class="sidebar-news" aria-labelledby="latest-news-title">
      <div class="sidebar-section-heading">
        <h2 id="latest-news-title">Latest news</h2>
        <a href="/news.html">All news</a>
      </div>
      <ol>
        {latestNews.slice(0, 4).map((item) => (
          <li>
            <time datetime={item.date}>{item.date}</time>
            <h3>{item.title}</h3>
            <div set:html={item.body} />
          </li>
        ))}
      </ol>
    </section>
  )}
</aside>
