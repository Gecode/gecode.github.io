---
import Sidebar from "../components/Sidebar.astro";
import { canonicalSitePath, site } from "../data/site";
import type { NewsItem } from "../lib/legacy-content";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  headline?: string;
  home?: boolean;
  latestNews?: NewsItem[];
}

const {
  title = site.title,
  description = site.description,
  headline,
  home = false,
  latestNews = [],
} = Astro.props;
const currentPath = canonicalSitePath(Astro.url.pathname);
const canonical = new URL(currentPath, site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content="gecode, constraint programming, constraint solver, constraint toolkit" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/gecode-logo.ico" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="page-frame">
      <main id="main-content" class:list={["site-main", { "is-home": home }]}>
        <div class="content-kicker" aria-hidden="true">generic constraint development environment</div>
        {home ? (
          <header class="hero-lockup">
            <img src="/images/gecode-logo-120.png" alt="Gecode" width="196" height="126" fetchpriority="high" />
            <div>
              <p>generic</p>
              <p>constraint</p>
              <p>development</p>
              <p>environment</p>
            </div>
          </header>
        ) : (
          <header class="page-header">
            <p>Gecode</p>
            <h1>{headline ?? "Gecode"}</h1>
          </header>
        )}
        <article class="prose-content">
          <slot />
        </article>
      </main>
      <Sidebar currentPath={currentPath} home={home} latestNews={latestNews} />
    </div>
    <footer class="site-footer">
      <p>Gecode is open source software, distributed under the MIT license.</p>
      <a href="/disclaimer">Disclaimer</a>
    </footer>
  </body>
</html>
