---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNews, loadLegacyPage } from "../lib/legacy-content";

const page = await loadLegacyPage("index.html");
const news = await getNews();
---

<BaseLayout
  title={String(page.data.title)}
  description={String(page.data.description)}
  home
  latestNews={news}
>
  <div set:html={page.body} />
</BaseLayout>
