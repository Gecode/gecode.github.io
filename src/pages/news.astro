---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNews } from "../lib/legacy-content";

const news = await getNews();
---

<BaseLayout title="GECODE news" headline="News Archive">
  <section class="page-section news-archive">
    <ol class="news-archive-list">
      {news.map((item) => (
        <li class="news-archive-item">
          <p class="news-item-date"><time datetime={item.date}>{item.date}</time></p>
          <article class="news-entry">
            <h3 class="news-entry-title">{item.title}</h3>
            <div class="news-entry-content" set:html={item.body} />
          </article>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
