---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNews } from "../lib/legacy-content";

const news = await getNews();
---

<BaseLayout title="GECODE news" headline="News archive">
  <p class="page-introduction">Release notes, community projects, interfaces, and milestones from the Gecode archive.</p>
  <ol class="news-archive">
    {news.map((item) => (
      <li>
        <time datetime={item.date}>{item.date}</time>
        <article>
          <h2>{item.title}</h2>
          <div set:html={item.body} />
        </article>
      </li>
    ))}
  </ol>
</BaseLayout>
