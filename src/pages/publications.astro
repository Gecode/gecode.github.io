---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublications } from "../lib/legacy-content";

const publications = await getPublications();
---

<BaseLayout title="GECODE publications" headline="Selected publications">
  <p class="page-introduction">The papers behind Gecode’s architecture, propagation techniques, and implementation.</p>
  <ol class="publication-list">
    {publications.map((publication) => (
      <li>
        <p class="publication-title">
          <a href={`/publications/${publication.slug}/`}>{publication.title}</a>
        </p>
        <p class="publication-authors">
          {publication.authors.map((author, index) => (
            <>
              {author.url ? <a href={author.url}>{author.name}</a> : author.name}
              {index < publication.authors.length - 1 ? ", " : ""}
            </>
          ))}
        </p>
        <p class="publication-venue">{publication.shorthowpub}</p>
        {publication.relation && <p class="publication-relation"><strong>Relation:</strong> {publication.relation}</p>}
      </li>
    ))}
  </ol>
</BaseLayout>
