---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublications, type Publication } from "../../lib/legacy-content";

export const getStaticPaths = (async () => {
  const publications = await getPublications();
  return publications.map((publication) => ({
    params: { slug: publication.slug },
    props: { publication },
  }));
}) satisfies GetStaticPaths;

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;
---

<BaseLayout
  title={publication.title}
  headline="Publications"
  description={publication.description}
  article={{
    authors: publication.authors.map((author) => author.name),
    publishedTime: publication.publishedDate,
  }}
>
  <article class="paper-detail">
    <h2>{publication.title}</h2>
    <p>
      {publication.authors.map((author, index) => (
        <>
          {author.url ? <a href={author.url}>{author.name}</a> : author.name}
          {index < publication.authors.length - 1 ? ", " : ""}
        </>
      ))}
    </p>
    <div set:html={publication.body} />
    {publication.link?.url && (
      <p class="menu">[ <a href={publication.link.url}>{publication.link.label}</a> ]</p>
    )}
    <p>{publication.howpublished}</p>
    {publication.copyright_text && (
      <p>
        {publication.copyright_text}{" "}
        {publication.copyright_url && (
          <a href={publication.copyright_url}>{publication.copyright_label}</a>
        )}
      </p>
    )}
  </article>
</BaseLayout>
