{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gecode-classic-url-redirects-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "env": {
    "production": {
      "name": "gecode-classic-url-redirects",
      "workers_dev": false,
      "routes": [
        { "pattern": "www.gecode.dev/community.html*", "zone_name": "gecode.dev" },
        { "pattern": "www.gecode.dev/disclaimer.html*", "zone_name": "gecode.dev" },
        { "pattern": "www.gecode.dev/documentation.html*", "zone_name": "gecode.dev" },
        { "pattern": "www.gecode.dev/download.html*", "zone_name": "gecode.dev" },
        { "pattern": "www.gecode.dev/flatzinc.html*", "zone_name": "gecode.dev" },
        { "pattern": "www.gecode.dev/index.html*", "zone_name": "gecode.dev" },
        { "pattern": "www.gecode.dev/interfaces.html*", "zone_name": "gecode.dev" },
        { "pattern": "www.gecode.dev/license.html*", "zone_name": "gecode.dev" },
        { "pattern": "www.gecode.dev/logo.html*", "zone_name": "gecode.dev" },
        { "pattern": "www.gecode.dev/news.html*", "zone_name": "gecode.dev" },
        { "pattern": "www.gecode.dev/projects.html*", "zone_name": "gecode.dev" },
        { "pattern": "www.gecode.dev/publications*", "zone_name": "gecode.dev" }
      ]
    }
  }
}
