{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Static Astro website. Assets only: no Worker script, so requests are
  // served from Workers Static Assets without counting as Worker invocations.
  // More specific Worker routes on www.gecode.dev (/doc*, /robots.txt*, /e/*
  // and classic .html pages) take precedence over this Custom Domain, and
  // their fetch() pass-through reaches this Worker as the origin.
  "name": "gecode-website-staging",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "assets": {
    "directory": "../../_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "www-staging.gecode.dev", "custom_domain": true }
  ],
  "env": {
    "production": {
      "name": "gecode-website",
      "workers_dev": false,
      "assets": {
        "directory": "../../_site",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      },
      "routes": [
        { "pattern": "www.gecode.dev", "custom_domain": true }
      ]
    }
  }
}
